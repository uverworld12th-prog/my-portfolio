# ===== eBay API 認証情報（このファイルをコピーして .env を作成）=====
# 開発・テスト中は必ず sandbox を使用すること
EBAY_ENV=sandbox            # sandbox | production

# 1 にするとeBay APIを呼ばずにモックデータで全工程を動かせる（認証情報不要）
EBAY_MOCK=0

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# OAuth User Token の Refresh Token（スコープ: sell.inventory）
EBAY_REFRESH_TOKEN=
# RuName（ユーザー同意フロー用。Refresh Token取得済みなら空でも可）
EBAY_RU_NAME=

# 出品先マーケットプレイス
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_MERCHANT_LOCATION_KEY=JP_WAREHOUSE_01

# Business Policies（Seller Hubで事前作成したIDを記入）
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=

# 在庫監視の通知（任意。Slack / Discord 等のIncoming Webhook URL）
NOTIFY_WEBHOOK_URL=
